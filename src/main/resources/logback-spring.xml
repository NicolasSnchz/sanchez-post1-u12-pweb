<!-- Logback: en dev, consola y archivo logs/pedidos.log (rotacion diaria, 30 dias); en cualquier otro
     perfil (prod) solo consola, porque en un contenedor los logs salen por la salida estandar y los
     recoge la plataforma. Los niveles los fija cada perfil con logging.level.*
     <springProfile> no puede ir dentro de <root>: por eso hay un <root> completo por perfil -->
<configuration>
  <appender name="CONSOLA" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss} %-5level %logger{30} - %msg%n</pattern>
    </encoder>
  </appender>

  <springProfile name="dev">
    <appender name="ARCHIVO"
              class="ch.qos.logback.core.rolling.RollingFileAppender">
      <file>logs/pedidos.log</file>
      <rollingPolicy
          class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
        <fileNamePattern>logs/pedidos.%d{yyyy-MM-dd}.log</fileNamePattern>
        <maxHistory>30</maxHistory>
      </rollingPolicy>
      <encoder>
        <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %logger - %msg%n</pattern>
      </encoder>
    </appender>

    <root level="INFO">
      <appender-ref ref="CONSOLA"/>
      <appender-ref ref="ARCHIVO"/>
    </root>
  </springProfile>

  <springProfile name="!dev">
    <root level="INFO">
      <appender-ref ref="CONSOLA"/>
    </root>
  </springProfile>
</configuration>
